# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/aniluna

# Kodik API key (required)
KODIK_API_KEY=your_kodik_api_key_here

# Session secret (run: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_random_secret

# Log level (optional)
LOG_LEVEL=info
